<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Doze: does this device support STATE_DOZE?  -->
    <bool name="doze_display_state_supported">true</bool>

    <!--  Flag to turn on the rendering of the above path or not  -->
    <bool name="config_enableDisplayCutoutProtection">true</bool>

    <!-- A path similar to frameworks/base/core/res/res/values/config.xml
      config_mainBuiltInDisplayCutout that describes a path larger than the exact path of a display
      cutout. If present as well as config_enableDisplayCutoutProtection is set to true, then
      SystemUI will draw this "protection path" instead of the display cutout path that is normally
      used for anti-aliasing.

      This path will only be drawn when the front-facing camera turns on, otherwise the main
      DisplayCutout path will be rendered
       -->
    <string name="config_frontBuiltInDisplayCutoutProtection" translatable="false">
        M 558,0
        m -34,57
        a 34,34 0 1,0 68,0
        a 34,34 0 1,0 -68,0
        Z
    </string>

    <!-- Preferred max refresh rate at keyguard, if supported by the display. -->
    <integer name="config_keyguardMaxRefreshRate">60</integer>

    <!--  ID for the camera that needs extra protection -->
    <string name="config_protectedCameraId" translatable="false">1</string>

    <!-- Physical ID for the camera of outer display that needs extra protection -->
    <string translatable="false" name="config_protectedPhysicalCameraId">1</string>

    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
        relies on this value will not be sized correctly. -->
    <item name="pixel_pitch" format="float" type="dimen">59.77</item>

    <!-- Location on the screen of the center of the physical power button. This is a reasonable
    default that should be overridden by device-specific overlays. -->
    <dimen name="physical_power_button_center_screen_location_y">1120px</dimen>

    <!-- Should we vibrate on an icon animation of the shelf. This should only be active if the
    vibrator is capable of subtle vibrations -->
    <bool name="config_vibrateOnIconAnimation">true</bool>

    <!-- StatusBar burn-in protection -->
    <bool name="config_statusBarBurnInProtection">true</bool>
    
    <!-- The padding on the start of the statusbar -->
    <dimen name="status_bar_padding_start">25px</dimen>

    <!-- The padding on the end of the statusbar -->
    <dimen name="status_bar_padding_end">0px</dimen>

    <!-- paddings for container with status icons and battery -->
    <!-- padding start is a bit smaller than end to account for status icon margin-->
    <dimen name="status_bar_icons_padding_start">3dp</dimen>

    <dimen name="status_bar_icons_padding_end">4dp</dimen>

    <!-- the radius of the overflow dot in the status bar -->
    <dimen name="overflow_dot_radius">2sp</dimen>

    <!-- the padding between dots in the icon overflow -->
    <dimen name="overflow_icon_dot_padding">3sp</dimen>

    <!-- Whether usage of the proximity sensor during doze is supported -->
    <bool name="doze_proximity_sensor_supported">false</bool>
</resources>
